+// Environment variables that change what a git command does in ways the
+// lazyer daemon does not know about. A command carrying one of the first
+// group always runs with git; one of the second group only when lazygit added
+// it to this command (inherited from our own environment, it applies to every
+// command alike and matters to none of the commands the daemon answers).
+var (
+	lazyerDeclinedEnv = []string{
+		"GIT_INDEX_FILE=", "GIT_DIR=", "GIT_WORK_TREE=", "GIT_NAMESPACE=", "GIT_OBJECT_DIRECTORY=",
+		"GIT_AUTHOR_", "GIT_COMMITTER_",
+	}
+	lazyerDeclinedIfAddedEnv = []string{"GIT_SEQUENCE_EDITOR=", "GIT_EDITOR=", "LAZYGIT_DAEMON_"}
+)
+
+// viaLazyer offers a git command to the lazyer daemon. When ok is true the
+// command was answered there: out is what git would have written to stdout,
+// and err is non-nil when git would have exited with a non-zero status.
+func (self *cmdObjRunner) viaLazyer(cmdObj *CmdObj) (out []byte, err error, ok bool) {
+	if !lazyer.Enabled() {
+		return nil, nil, false
+	}
+	cmd := cmdObj.GetCmd()
+	args := cmd.Args
+	if len(args) < 2 || args[0] != "git" || cmd.Stdin != nil {
+		return nil, nil, false
+	}
+	var inherited map[string]bool
+	for _, v := range cmd.Env {
+		for _, declined := range lazyerDeclinedEnv {
+			if strings.HasPrefix(v, declined) {
+				return nil, nil, false
+			}
+		}
+		for _, declined := range lazyerDeclinedIfAddedEnv {
+			if strings.HasPrefix(v, declined) {
+				if inherited == nil {
+					inherited = map[string]bool{}
+					for _, e := range os.Environ() {
+						inherited[e] = true
+					}
+				}
+				if !inherited[v] {
+					return nil, nil, false
+				}
+			}
+		}
+	}
+	t := time.Now()
+	handled, code, stdout := lazyer.Exec(cmd.Dir, args[1:])
+	if !handled {
+		return nil, nil, false
+	}
+	self.log.Infof("%s (lazyer %s)", cmdObj.ToString(), time.Since(t))
+	if code != 0 {
+		return stdout, fmt.Errorf("exit status %d", code), true
+	}
+	return stdout, nil, true
+}
+
+// viaLazyerLogged is viaLazyer for the paths that would otherwise stream the
+// command's output: the command still shows up in the command log.
+func (self *cmdObjRunner) viaLazyerLogged(cmdObj *CmdObj) ([]byte, error, bool) {
+	out, err, ok := self.viaLazyer(cmdObj)
+	if ok {
+		if cmdObj.ShouldLog() {
+			self.logCmdObj(cmdObj)
+		}
+		if err != nil {
+			_, err = sanitisedCommandOutput(out, err)
+		}
+	}
+	return out, err, ok
+}
+
 func (self *cmdObjRunner) logCmdObj(cmdObj *CmdObj) {
 	self.guiIO.logCommandFn(cmdObj.ToString(), true)
 }
