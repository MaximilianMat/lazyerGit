+// WholeFilesOnly returns the files of the patch when each of them is included
+// as a whole: no line selections and no renames. ok is false otherwise, or
+// when the patch is empty.
+func (p *PatchBuilder) WholeFilesOnly() (files []string, ok bool) {
+	for name, info := range p.snapshotFileInfoMap() {
+		switch info.mode {
+		case UNSELECTED:
+		case WHOLE:
+			if info.previousPath != "" {
+				return nil, false
+			}
+			files = append(files, name)
+		default:
+			return nil, false
+		}
+	}
+	sort.Strings(files)
+	return files, len(files) > 0
+}
+
 func (p *PatchBuilder) AllFilesInPatch() []string {
 	return lo.Keys(p.snapshotFileInfoMap())
 }
diff --git a/pkg/lazyer/lazyer.go b/pkg/lazyer/lazyer.go
new file mode 100644
index 0000000..a3c83ea
--- /dev/null
+++ b/pkg/lazyer/lazyer.go
@@ -0,0 +1,165 @@
+// Package lazyer lets lazygit ask the lazyer daemon for the result of a git
+// command instead of starting git. The daemon answers only command lines it
+// reproduces exactly; everything else is declined and runs as before.
+//
+// Set LAZYER=0 to switch this off, LAZYER_BIN to the daemon binary (default:
+// "lazyer" next to this executable, else on PATH) and LAZYER_SOCKET to its socket (default:
+// ~/.cache/lazyer/daemon.sock).
+package lazyer
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+var (
+	setup      sync.Once
+	enabled    bool
+	socketPath string
+	binPath    string
+
+	spawnMu   sync.Mutex
+	lastSpawn time.Time
+	failures  atomic.Int32
+)
+
+// After this many consecutive failures to reach the daemon it is left alone
+// for the rest of the session.
+const maxFailures = 3
+
+func initialise() {
+	if os.Getenv("LAZYER") == "0" {
+		return
+	}
+	socketPath = os.Getenv("LAZYER_SOCKET")
+	if socketPath == "" {
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return
+		}
+		socketPath = filepath.Join(home, ".cache", "lazyer", "daemon.sock")
+	}
+	binPath = os.Getenv("LAZYER_BIN")
+	if binPath == "" {
+		// Installed side by side: look next to this executable first.
+		if self, err := os.Executable(); err == nil {
+			sibling := filepath.Join(filepath.Dir(self), "lazyer")
+			if info, serr := os.Stat(sibling); serr == nil && !info.IsDir() {
+				binPath = sibling
+			}
+		}
+	}
+	if binPath == "" {
+		if found, err := exec.LookPath("lazyer"); err == nil {
+			binPath = found
+		}
+	}
+	enabled = true
+}
+
+// Enabled reports whether git commands are offered to the daemon.
+func Enabled() bool {
+	setup.Do(initialise)
+	return enabled && failures.Load() < maxFailures
+}
+
+func dial() (net.Conn, error) {
+	conn, err := net.DialTimeout("unix", socketPath, 200*time.Millisecond)
+	if err == nil {
+		return conn, nil
+	}
+	if binPath == "" {
+		return nil, err
+	}
+	// Start the daemon, at most once every few seconds, and wait for it.
+	spawnMu.Lock()
+	defer spawnMu.Unlock()
+	if conn, err := net.DialTimeout("unix", socketPath, 200*time.Millisecond); err == nil {
+		return conn, nil
+	}
+	if time.Since(lastSpawn) < 5*time.Second {
+		return nil, err
+	}
+	lastSpawn = time.Now()
+	_ = os.MkdirAll(filepath.Dir(socketPath), 0o755)
+	cmd := exec.Command(binPath, "daemon")
+	cmd.Env = append(os.Environ(), "LAZYER_SOCKET="+socketPath)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	if logFile, lerr := os.OpenFile(socketPath[:len(socketPath)-len(filepath.Ext(socketPath))]+".log", os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644); lerr == nil {
+		cmd.Stderr = logFile
+		defer logFile.Close()
+	}
+	if serr := cmd.Start(); serr != nil {
+		return nil, serr
+	}
+	go func() { _ = cmd.Wait() }()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if conn, derr := net.DialTimeout("unix", socketPath, 100*time.Millisecond); derr == nil {
+			return conn, nil
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	return nil, err
+}
+
+// Exec asks the daemon for the result of `git <args>` run in dir. When
+// handled is false the command has to be run with git; nothing was changed.
+func Exec(dir string, args []string) (handled bool, exitCode int, stdout []byte) {
+	if !Enabled() || len(args) == 0 {
+		return false, 0, nil
+	}
+	if dir == "" {
+		wd, err := os.Getwd()
+		if err != nil {
+			return false, 0, nil
+		}
+		dir = wd
+	}
+	conn, err := dial()
+	if err != nil {
+		failures.Add(1)
+		return false, 0, nil
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(60 * time.Second))
+
+	size := len(dir)
+	for _, a := range args {
+		size += 1 + len(a)
+	}
+	frame := make([]byte, 4, 4+size)
+	binary.BigEndian.PutUint32(frame, uint32(size))
+	frame = append(frame, dir...)
+	for _, a := range args {
+		frame = append(frame, 0)
+		frame = append(frame, a...)
+	}
+	if _, err := conn.Write(frame); err != nil {
+		failures.Add(1)
+		return false, 0, nil
+	}
+	var head [9]byte
+	if _, err := io.ReadFull(conn, head[:]); err != nil {
+		failures.Add(1)
+		return false, 0, nil
+	}
+	out := make([]byte, binary.BigEndian.Uint32(head[5:9]))
+	if _, err := io.ReadFull(conn, out); err != nil {
+		failures.Add(1)
+		return false, 0, nil
+	}
+	failures.Store(0)
+	if head[0] != 1 {
+		return false, 0, nil
+	}
+	return true, int(int32(binary.BigEndian.Uint32(head[1:5]))), out
+}
